---
const { current = '', locale = 'en' } = Astro.props;

const nav = {
  en: [
    { href: '/', key: 'home', label: 'Home' },
    { href: '/services/', key: 'services', label: 'Services' },
    { href: '/about/', key: 'about', label: 'About' },
    { href: '/teachinglocalization/', key: 'teaching', label: 'Teaching localization' },
    { href: '/blog/', key: 'blog', label: 'Blog' },
    { href: '/contact/', key: 'contact', label: 'Contact' },
  ],
  fr: [
    { href: '/fr/', key: 'home', label: 'Accueil' },
    { href: '/fr/services/', key: 'services', label: 'Services' },
    { href: '/fr/about/', key: 'about', label: 'À propos' },
    { href: '/fr/teachinglocalization/', key: 'teaching', label: 'Enseignement' },
    { href: '/blog/', key: 'blog', label: 'Blog' },
    { href: '/fr/contact/', key: 'contact', label: 'Contact' },
  ],
};

/* Same page in the other language, for the EN | FR switcher */
const twins = {
  home:     { en: '/',          fr: '/fr/' },
  services: { en: '/services/', fr: '/fr/services/' },
  about:    { en: '/about/',    fr: '/fr/about/' },
  teaching: { en: '/teachinglocalization/', fr: '/fr/teachinglocalization/' },
  blog:     { en: '/blog/',     fr: '/blog/' },
  contact:  { en: '/contact/',  fr: '/fr/contact/' },
};
const twin = twins[current] || { en: '/', fr: '/fr/' };
const links = nav[locale] || nav.en;
const homeHref = locale === 'fr' ? '/fr/' : '/';
---
<header class="site-header">
  <div class="wrap">
    <a href={homeHref} class="wordmark"><em>French</em>SaaS<span class="tld">.com</span></a>
    <nav class="site-nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
      <span class="lang-switch" aria-label="Language">
        <a href={twin.en} aria-current={locale === 'en' ? 'true' : undefined} lang="en" hreflang="en">EN</a><span class="sep">/</span><a href={twin.fr} aria-current={locale === 'fr' ? 'true' : undefined} lang="fr" hreflang="fr">FR</a>
      </span>
    </nav>
  </div>
</header>

<style>
  .lang-switch {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding-left: 1.2rem;
    border-left: 1px solid var(--line);
  }
  .lang-switch a { color: var(--grey); padding-bottom: 2px; border-bottom: 2px solid transparent; }
  .lang-switch a:hover { color: var(--purple); }
  .lang-switch a[aria-current="true"] { color: var(--purple); border-bottom-color: var(--purple); }
  .lang-switch .sep { color: var(--line); }
</style>
