---
const { current = '', locale = 'en' } = Astro.props;

const servicesSub = {
  en: [
    { href: '/saas-localization/', label: 'Your SaaS into French' },
    { href: '/steam-localization/', label: 'Your game website or Steam page into French' },
    { href: '/website-localization/', label: 'Your website into French' },
  ],
  fr: [
    { href: '/saas-localization/', label: 'Your SaaS into French' },
    { href: '/steam-localization/', label: 'Your game website or Steam page into French' },
    { href: '/website-localization/', label: 'Your website into French' },
  ],
};
const subLinks = servicesSub[locale] || servicesSub.en;

const nav = {
  en: [
    { href: '/', key: 'home', label: 'Home' },
    { href: '/services/', key: 'services', label: 'Services' },
    { href: '/about/', key: 'about', label: 'About' },
    { href: '/teachinglocalization/', key: 'teaching', label: 'Teaching localization' },
    { href: '/faq/', key: 'faq', label: 'FAQ' },
    { href: '/blog/', key: 'blog', label: 'Blog' },
    { href: '/contact/', key: 'contact', label: 'Contact' },
  ],
  fr: [
    { href: '/fr/', key: 'home', label: 'Accueil' },
    { href: '/fr/services/', key: 'services', label: 'Services' },
    { href: '/fr/about/', key: 'about', label: 'À propos' },
    { href: '/fr/teachinglocalization/', key: 'teaching', label: 'Enseignement' },
    { href: '/faq/', key: 'faq', label: 'FAQ' },
    { href: '/blog/', key: 'blog', label: 'Blog' },
    { href: '/fr/contact/', key: 'contact', label: 'Contact' },
  ],
};

/* Same page in the other language, for the EN | FR switcher */
const twins = {
  home:     { en: '/',          fr: '/fr/' },
  services: { en: '/services/', fr: '/fr/services/' },
  about:    { en: '/about/',    fr: '/fr/about/' },
  teaching: { en: '/teachinglocalization/', fr: '/fr/teachinglocalization/' },
  faq:      { en: '/faq/', fr: '/faq/' },
  blog:     { en: '/blog/',     fr: '/blog/' },
  contact:  { en: '/contact/',  fr: '/fr/contact/' },
};
const twin = twins[current] || { en: '/', fr: '/fr/' };
const links = nav[locale] || nav.en;
const homeHref = locale === 'fr' ? '/fr/' : '/';
---
<header class="site-header">
  <div class="wrap">
    <a href={homeHref} class="wordmark"><em>French</em>SaaS<span class="tld">.com</span></a>
    <nav class="site-nav" aria-label="Main">
      {links.map((l) => (
        l.key === 'services' ? (
          <div class="has-dropdown">
            <a href={l.href} class="dropdown-trigger" aria-current={current === l.key ? 'page' : undefined} aria-haspopup="true" aria-expanded="false">{l.label}<span class="caret" aria-hidden="true"></span></a>
            <div class="dropdown-menu">
              {subLinks.map((s) => (
                <a href={s.href} class="dropdown-item">{s.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
        )
      ))}
      <span class="lang-switch" aria-label="Language">
        <a href={twin.en} aria-current={locale === 'en' ? 'true' : undefined} lang="en" hreflang="en">EN</a><span class="sep">/</span><a href={twin.fr} aria-current={locale === 'fr' ? 'true' : undefined} lang="fr" hreflang="fr">FR</a>
      </span>
    </nav>
  </div>
</header>

<style>
  .lang-switch {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding-left: 1.2rem;
    border-left: 1px solid var(--line);
  }
  .lang-switch a { color: var(--grey); padding-bottom: 2px; border-bottom: 2px solid transparent; }
  .lang-switch a:hover { color: var(--purple); }
  .lang-switch a[aria-current="true"] { color: var(--purple); border-bottom-color: var(--purple); }
  .lang-switch .sep { color: var(--line); }

  /* ---------- Services dropdown ---------- */
  .has-dropdown { position: relative; display: inline-flex; align-items: baseline; }
  .dropdown-trigger { display: inline-flex; align-items: center; gap: 0.35rem; }
  .caret {
    width: 0; height: 0;
    border-left: 3.5px solid transparent;
    border-right: 3.5px solid transparent;
    border-top: 4px solid currentColor;
    opacity: 0.6;
    transition: transform 0.2s ease;
  }
  .has-dropdown:hover .caret, .has-dropdown:focus-within .caret { transform: rotate(180deg); }
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 0.6rem;
    min-width: 20rem;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 16px 40px rgba(23,20,43,0.12);
    padding: 0.4rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 50;
  }
  /* petite zone tampon pour ne pas perdre le survol */
  .dropdown-menu::before { content: ""; position: absolute; top: -0.6rem; left: 0; right: 0; height: 0.6rem; }
  .has-dropdown:hover .dropdown-menu, .has-dropdown:focus-within .dropdown-menu {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  .dropdown-item {
    display: block;
    padding: 0.7rem 0.9rem;
    font-family: var(--body);
    font-size: 0.9rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink);
    border-bottom: none !important;
    line-height: 1.4;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dropdown-item:hover { background: var(--tint); color: var(--purple); }
  @media (max-width: 860px) {
    .has-dropdown { display: block; width: 100%; }
    .dropdown-menu {
      position: static; opacity: 1; visibility: visible; transform: none;
      box-shadow: none; border: none; margin-top: 0.2rem; padding: 0 0 0 1rem; min-width: 0;
    }
    .dropdown-menu::before { display: none; }
    .caret { display: none; }
  }
</style>
