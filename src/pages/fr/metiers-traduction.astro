---
import Base from '../../layouts/Base.astro';

const metiers = [
  {
    code: "TECH",
    nom: "Traducteur·rice technique",
    intro: "Traduire des contenus spécialisés (documentation, notices, fiches produits, contenus industriels) où la précision terminologique prime.",
    quotidien: "Traduire des manuels, des spécifications, des contenus scientifiques ou industriels, en respectant une terminologie stricte et souvent un glossaire client. Beaucoup de recherche documentaire et de rigueur.",
    competences: "Maîtrise d'un ou plusieurs domaines de spécialité, rigueur terminologique, recherche documentaire, gestion de glossaires.",
    outils: "Outils de TAO (Trados, memoQ, Phrase), bases terminologiques, mémoires de traduction.",
    debouches: "Indépendant, agences de traduction, services de documentation en entreprise, secteurs industriels et scientifiques.",
    pour: "Celles et ceux qui aiment la précision, la recherche et l'expertise d'un domaine."
  },
  {
    code: "AV",
    nom: "Traducteur·rice audiovisuel·le",
    intro: "Adapter des contenus audiovisuels : sous-titrage, doublage, voice-over, audiodescription.",
    quotidien: "Traduire et adapter des dialogues sous contrainte de temps et d'espace (nombre de caractères par ligne, synchronisation), pour des films, séries, documentaires, vidéos d'entreprise ou de jeux.",
    competences: "Sens du rythme et de l'oralité, concision, adaptation culturelle, respect des contraintes techniques de repérage.",
    outils: "Logiciels de sous-titrage (Subtitle Edit, EZTitles, Ooona), outils de repérage.",
    debouches: "Indépendant, laboratoires de sous-titrage, plateformes de streaming, studios de doublage.",
    pour: "Celles et ceux qui aiment le cinéma, la contrainte créative et l'adaptation fine."
  },
  {
    code: "LITT",
    nom: "Traducteur·rice littéraire",
    intro: "Traduire des œuvres : romans, essais, bande dessinée, poésie, pour l'édition.",
    quotidien: "Restituer le style, la voix et l'intention d'un·e auteur·rice dans une autre langue. Un travail d'écriture autant que de traduction, souvent en lien étroit avec les maisons d'édition.",
    competences: "Talent d'écriture, sensibilité littéraire, culture générale, patience — les projets sont longs.",
    outils: "Peu d'outils de TAO ; surtout des dictionnaires, ouvrages de référence et un traitement de texte.",
    debouches: "Édition, souvent au forfait ou en droits d'auteur. Un milieu exigeant et passionné.",
    pour: "Celles et ceux qui écrivent autant qu'ils traduisent, et aiment servir un texte."
  },
  {
    code: "JUR",
    nom: "Traducteur·rice juridique / assermenté·e",
    intro: "Traduire des documents à valeur légale : contrats, jugements, actes, documents officiels.",
    quotidien: "Traduire avec une exactitude absolue des textes où chaque mot engage. Le·la traducteur·rice assermenté·e (expert judiciaire) certifie des traductions officielles reconnues par les administrations.",
    competences: "Connaissance des systèmes juridiques source et cible, rigueur extrême, confidentialité, terminologie juridique.",
    outils: "TAO, bases terminologiques juridiques, ressources légales officielles.",
    debouches: "Cabinets d'avocats, tribunaux, notaires, entreprises, administrations. L'assermentation ouvre un marché réglementé.",
    pour: "Celles et ceux que le droit passionne et qui ont le goût de la responsabilité."
  },
  {
    code: "L10N",
    nom: "Localisateur·rice",
    intro: "Adapter un produit numérique (logiciel, application, site, jeu vidéo) à une langue et une culture cibles — bien au-delà de la traduction.",
    quotidien: "Traduire et adapter des interfaces, gérer les pluriels, les variables, les formats de date et de devise, les contraintes d'affichage, en travaillant souvent dans le pipeline technique du produit (fichiers XLIFF, JSON, ICU MessageFormat).",
    competences: "Rigueur linguistique ET aisance technique, compréhension de l'i18n, sens du produit et de l'expérience utilisateur.",
    outils: "TAO, plateformes de localisation (Phrase, Lokalise, Crowdin), notions de Git et de formats de fichiers.",
    debouches: "SaaS, éditeurs de logiciels, studios de jeux vidéo, agences spécialisées. Un marché en croissance.",
    pour: "Celles et ceux qui aiment la langue ET la technique, et veulent que leur travail vive dans un produit."
  },
  {
    code: "UXW",
    nom: "UX writer / rédacteur·rice d'interface",
    intro: "Concevoir et rédiger les textes d'une interface (boutons, messages, parcours) pour qu'elle soit claire, fluide et engageante.",
    quotidien: "Écrire la microcopie d'un produit, souvent en collaboration avec les équipes design et produit. À la frontière de la rédaction, de la traduction et du design d'expérience.",
    competences: "Écriture concise et centrée utilisateur, sens du design, empathie, parfois recherche utilisateur.",
    outils: "Figma, outils de design, plateformes de contenu, parfois outils de localisation.",
    debouches: "Entreprises tech, SaaS, studios de design. Un profil de plus en plus recherché.",
    pour: "Celles et ceux qui aiment façonner l'expérience par les mots, au plus près du produit."
  },
  {
    code: "LEAD",
    nom: "Language Lead",
    intro: "Piloter la qualité linguistique d'un produit dans une langue : cohérence, terminologie, style, relecture, stratégie.",
    quotidien: "Définir le guide de style et le glossaire, arbitrer les décisions linguistiques (tu/vous, ton, terminologie), relire en contexte, coordonner des prestataires, et faire évoluer la qualité au fil des versions du produit.",
    competences: "Expertise linguistique confirmée, sens de la cohérence à grande échelle, pédagogie, autonomie, vision produit.",
    outils: "Guides de style, glossaires, mémoires, plateformes de localisation, outils de gestion terminologique.",
    debouches: "SaaS et entreprises tech en croissance, en interne ou en freelance. Un rôle stratégique, encore rare et différenciant.",
    pour: "Celles et ceux qui veulent posséder une langue dans un produit, pas seulement traduire des chaînes."
  },
  {
    code: "TERM",
    nom: "Terminologue",
    intro: "Créer, structurer et maintenir les terminologies : bases de termes, glossaires, nomenclatures.",
    quotidien: "Recenser, définir et harmoniser les termes d'un domaine ou d'une organisation, pour garantir la cohérence de tous les contenus. Un travail de fond, méthodique et transversal.",
    competences: "Rigueur méthodologique, goût de la recherche, connaissance des domaines, maîtrise des outils terminologiques.",
    outils: "Bases terminologiques (SDL MultiTerm, bases maison), outils de gestion de la connaissance.",
    debouches: "Grandes entreprises, institutions, organisations internationales, services de localisation.",
    pour: "Celles et ceux qui aiment structurer, définir et mettre de l'ordre dans les mots."
  },
  {
    code: "MTPE",
    nom: "Réviseur·e / post-éditeur·rice (MTPE)",
    intro: "Réviser des traductions humaines, ou post-éditer des traductions produites par la machine (MTPE).",
    quotidien: "Corriger, améliorer et valider des textes traduits — par un·e collègue ou par un moteur de traduction automatique — pour atteindre le niveau de qualité attendu. Un rôle central à l'ère de l'IA.",
    competences: "Œil critique, connaissance des erreurs typiques de la traduction automatique, rapidité, exigence de qualité.",
    outils: "TAO, moteurs de traduction automatique, outils de contrôle qualité (QA).",
    debouches: "Agences, entreprises, plateformes. Un segment en pleine évolution avec l'essor de l'IA.",
    pour: "Celles et ceux qui ont un œil affûté et savent juger, corriger et décider."

<div class="met-callout">
  <span class="met-callout-label">La nuance qui compte</span>
  <p>On <strong>révise</strong> l'humain, mais on <strong>post-édite</strong> la machine — et ce n'est pas qu'une affaire de vocabulaire. Réviser une traduction humaine, c'est dialoguer avec les choix d'un·e collègue. Post-éditer une sortie de traduction automatique, c'est traquer des erreurs d'un autre type : contresens plausibles, faux-amis invisibles, cohérence qui décroche, fautes que la fluidité de surface camoufle. C'est un travail cognitivement plus exigeant qu'il n'y paraît — il faut rester en vigilance constante pour ne pas se laisser bercer par un texte qui « sonne » juste sans l'être. Confondre les deux, c'est sous-estimer la post-édition.</p>
</div>

  },
  {
    code: "PM",
    nom: "Chef·fe de projet localisation",
    intro: "Coordonner les projets de traduction et de localisation : délais, budgets, prestataires, qualité.",
    quotidien: "Organiser le flux entre clients, traducteurs, relecteurs et outils. Gérer les plannings, les ressources et la qualité, sans nécessairement traduire soi-même.",
    competences: "Organisation, communication, gestion, compréhension des processus de traduction et des outils.",
    outils: "Systèmes de gestion de la traduction (TMS), outils de gestion de projet, plateformes de localisation.",
    debouches: "Agences de traduction, services de localisation en entreprise, éditeurs de logiciels.",
    pour: "Celles et ceux qui aiment coordonner, organiser et faire aboutir des projets."
  },
  {
    code: "INTERP",
    nom: "Interprète",
    intro: "Traduire oralement, en direct : interprétation de conférence (simultanée), de liaison, ou consécutive.",
    quotidien: "Restituer un discours d'une langue à l'autre en temps réel, lors de conférences, réunions, rendez-vous ou procédures. Un métier distinct de la traduction écrite, avec ses propres formations.",
    competences: "Réactivité, mémoire, maîtrise parfaite des langues à l'oral, résistance au stress, culture générale.",
    outils: "Cabine d'interprétation, matériel audio, plateformes d'interprétation à distance.",
    debouches: "Institutions, organisations internationales, tribunaux, secteur médical, événementiel.",
    pour: "Celles et ceux qui pensent vite, aiment l'oral et le direct."
  }
];
---
<Base
  current="metiers"
  title="Les métiers de la traduction expliqués | FrenchSaaS"
  description="Panorama des métiers de la traduction et de la localisation : traducteur technique, audiovisuel, littéraire, juridique, localisateur, UX writer, Language Lead, interprète… Le quotidien, les compétences et les débouchés de chaque voie."
>
  <section class="page-head">
    <span class="deco deco-guillemets" data-parallax="0.18" aria-hidden="true">«&nbsp;»</span>
    <div class="wrap">
      <div class="stagger"><span class="eyebrow">Ressource</span></div>
      <h1 class="display-xl stagger">Les métiers de la traduction</h1>
      <p class="lede stagger">« Traducteur », ce n'est pas un seul métier, mais une dizaine de voies très différentes. Voici un panorama honnête pour t'aider à trouver la tienne.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap met-wrap">
      <p class="met-intro reveal">Étudiant·e, en reconversion, ou simplement curieux·se : ce panorama présente les principaux métiers de la traduction et de la localisation. Chaque fiche suit la même structure — le quotidien, les compétences, les outils, les débouchés, et pour qui c'est fait — pour que tu puisses les comparer d'un coup d'œil. Déplie celles qui t'intriguent.</p>

      <div class="met-list">
        {metiers.map((m, i) => (
          <details class="met-item reveal" style={`--d:${Math.min(i * 0.03, 0.3)}s;`}>
            <summary>
              <span class="met-code">{m.code}</span>
              <span class="met-nom">{m.nom}</span>
              <span class="met-icon" aria-hidden="true"></span>
            </summary>
            <div class="met-body">
              <p class="met-lead">{m.intro}</p>
              <div class="met-grid">
                <div class="met-field"><span class="met-label">Au quotidien</span><p>{m.quotidien}</p></div>
                <div class="met-field"><span class="met-label">Compétences clés</span><p>{m.competences}</p></div>
                <div class="met-field"><span class="met-label">Outils</span><p>{m.outils}</p></div>
                <div class="met-field"><span class="met-label">Débouchés</span><p>{m.debouches}</p></div>
              </div>
              <p class="met-pour"><span class="met-pour-label">Pour qui ?</span> {m.pour}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="met-hybrid reveal">
        <h2>Et si on ne veut pas choisir ?</h2>
        <p>Ces voies ne sont pas étanches. Beaucoup de professionnel·les en combinent plusieurs, évoluent de l'une à l'autre, ou construisent un profil hybride au fil de leur carrière. C'est d'ailleurs mon cas : localisation, enseignement, direction linguistique. L'essentiel n'est pas de cocher une case, mais de savoir ce qui te motive — la précision d'un texte, le fonctionnement d'un produit, le contact humain, la transmission — et de bâtir ton chemin autour.</p>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <span class="deco" data-parallax="-0.08" aria-hidden="true">»</span>
    <div class="wrap">
      <h2 class="display-l reveal">Envie d'en parler avec d'autres traducteur·rices ?</h2>
      <p class="reveal" style="--d:0.08s;">Rejoins Tradiscord, l'une des plus grandes communautés francophones de traducteurs — 1 500+ collègues qui échangent conseils, retours d'expérience et discussions de métier.</p>
      <a class="btn reveal" style="--d:0.16s;" href="https://tradiscord.fr" target="_blank" rel="noopener">Rejoindre la communauté</a>
    </div>
  </section>
</Base>

<style>
  .met-wrap { max-width: 48em; }
  .met-intro { color: var(--grey); font-size: 1.05rem; line-height: 1.7; margin-bottom: 2rem; max-width: 44em; }

  .met-list { }
  .met-item { border-top: 1px solid var(--line); }
  .met-item:last-of-type { border-bottom: 1px solid var(--line); }
  .met-item summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; gap: 1.1rem;
    padding: 1.3rem 0.4rem;
  }
  .met-item summary::-webkit-details-marker { display: none; }
  .met-code {
    font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.08em;
    color: var(--purple); border: 1px solid var(--line); padding: 0.3rem 0.5rem;
    border-radius: 2px; flex: 0 0 auto; min-width: 4.2rem; text-align: center;
  }
  .met-nom {
    font-family: var(--display); font-weight: 600;
    font-size: clamp(1.1rem, 2vw, 1.35rem); color: var(--ink); flex: 1; line-height: 1.25;
  }
  .met-item summary:hover .met-nom { color: var(--purple); }
  .met-icon { flex: 0 0 auto; position: relative; width: 16px; height: 16px; }
  .met-icon::before, .met-icon::after {
    content: ""; position: absolute; background: var(--purple);
    transition: transform 0.28s ease, opacity 0.28s ease;
  }
  .met-icon::before { left: 0; top: 7px; width: 16px; height: 2px; }
  .met-icon::after { left: 7px; top: 0; width: 2px; height: 16px; }
  .met-item[open] .met-icon::after { transform: scaleY(0); opacity: 0; }

  .met-body { padding: 0 0.4rem 1.6rem; animation: metReveal 0.35s ease; }
  .met-lead {
    font-family: var(--display); font-style: italic; font-size: 1.15rem;
    color: var(--ink); margin: 0 0 1.4rem; max-width: 42em;
  }
  .met-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem 2rem; }
  @media (max-width: 620px) { .met-grid { grid-template-columns: 1fr; } }
  .met-label {
    font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--purple); display: block; margin-bottom: 0.4rem;
  }
  .met-field p { font-size: 0.92rem; color: var(--grey); margin: 0; line-height: 1.6; }
  .met-pour {
    margin: 1.4rem 0 0; padding-top: 1.2rem; border-top: 1px solid var(--line);
    font-size: 0.95rem; color: var(--ink);
  }
  .met-pour-label { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--purple); margin-right: 0.5rem; }

  @keyframes metReveal { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .met-body { animation: none; } .met-icon::before, .met-icon::after { transition: none; } }

  .met-hybrid {
    margin-top: 3rem; padding: 2rem 2.2rem;
    background: linear-gradient(150deg, var(--tint), #fff); border: 1px solid var(--line);
  }
  .met-hybrid h2 { font-size: clamp(1.4rem, 2.6vw, 1.8rem); margin-bottom: 0.9rem; }
  .met-hybrid p { color: var(--grey); margin: 0; line-height: 1.7; max-width: 44em; }

.met-callout {
  margin-top: 1.4rem;
  padding: 1.2rem 1.4rem;
  border-left: 3px solid var(--purple);
  background: var(--tint);
}
.met-callout-label {
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--purple);
  display: block;
  margin-bottom: 0.5rem;
}
.met-callout p {
  font-size: 0.92rem;
  color: var(--ink);
  margin: 0;
  line-height: 1.65;
}
.met-callout strong { color: var(--purple); font-weight: 600; }
</style>
