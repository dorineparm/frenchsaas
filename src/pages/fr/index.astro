---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d) =>
  d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' });
---
<Base current="home" lang="fr" title="FrenchSaaS — Localisation française pour produits SaaS" description="Localisation EN→FR, UX writing et assurance qualité linguistique pour les produits SaaS, tech et IA.">
  <!-- ======== Hero ======== -->
  <section class="hero">
    <span class="deco deco-guillemets" data-parallax="0.18" aria-hidden="true">«&nbsp;»</span>
    <span class="deco deco-locale" data-parallax="0.32" aria-hidden="true">fr-FR</span>

    <div class="wrap">
      <div class="hero-layout">
        <div class="hero-text">
      <div class="stagger"><span class="eyebrow">en-US <span class="arrow">→</span> fr-FR</span></div>

      <div class="stagger">
        <div class="lang-toggle" role="navigation" aria-label="Cette page en anglais ou en français">
          <a href="/">EN</a>
          <a href="/fr/" aria-current="page">FR</a>
        </div>
      </div>

      <h1 class="display-xl stagger">La localisation au service de votre développement international.</h1>

      <p class="lede stagger">Localisation, UX writing et assurance qualité linguistique pour les produits SaaS, tech et le jeu vidéo — par une Language Lead pour qui chaque chaîne est une décision produit.</p>

      <div class="hero-cta stagger">
        <a class="btn btn-solid" href="/fr/contact/">Lancer un projet</a>
        <a class="btn btn-ghost" href="/fr/services/">Voir les services</a>
      </div>
        </div><!-- /hero-text -->

        <div class="hero-photo stagger">
          <img src="/images/uploads/b62f33fc-9a70-4d11-84f1-30d981969f94.png" alt="Dorine Parmentier, Language Lead et spécialiste de la localisation EN→FR" loading="eager" />
        </div>
      </div><!-- /hero-layout -->
    </div>
  </section>

  <!-- ======== Manifeste ======== -->
  <section class="section manifesto">
    <div class="wrap">
      <span class="eyebrow reveal">Pourquoi c'est important</span>
      <p class="reveal">La France est l'un des plus grands marchés SaaS d'Europe — et l'un des moins indulgents envers les textes au goût de traduction automatique. Un utilisateur français sait dès le premier écran si votre produit a été <strong>localisé</strong> ou simplement traduit.</p>
      <p class="reveal" style="--d:0.12s;">La localisation n'est pas un remplacement de chaînes. C'est une suite de décisions linguistiques expertes : ton, terminologie, pluriels, variables, CTA, nuances juridiques. C'est mon métier.</p>
    </div>
<div class="stat-row reveal" style="--d:0.2s;">
        <div class="stat">
          <div class="stat-num">76<span>%</span></div>
          <div class="stat-lbl">des acheteurs préfèrent acheter dans leur langue maternelle</div>
        </div>
        <div class="stat">
          <div class="stat-num">40<span>%</span></div>
          <div class="stat-lbl">n'achètent jamais sur un site dans une autre langue</div>
        </div>
        <div class="stat">
          <div class="stat-num">+20<span>%</span></div>
          <div class="stat-lbl">d'expansion moyenne du texte de l'anglais vers le français</div>
        </div>
      </div>
  </section>

  <!-- ======== Services grid ======== -->
  <section class="section services-section">
    <div class="wrap">
      <span class="eyebrow reveal">Services</span>
      <h2 class="display-l reveal" style="margin-bottom:2.4rem;">Ce que je peux faire pour votre produit</h2>

      <div class="svc-grid">
        <a class="svc-card reveal" href="/fr/services/">
          <span class="svc-code">L10N</span>
          <span class="svc-name">Localisation logicielle</span>
          <span class="svc-desc">Interface, onboarding, emails et centre d'aide — dans un français qui sonne natif, chaînes traitées correctement du premier coup.</span>
          <span class="svc-arrow">→</span>
        </a>
        <a class="svc-card reveal" style="--d:0.05s;" href="/fr/services/">
          <span class="svc-code">UXW</span>
          <span class="svc-name">UX writing &amp; CTA</span>
          <span class="svc-desc">Un microcopy qui convertit : boutons, états vides et appels à l'action réécrits pour la façon dont les Français lisent et cliquent.</span>
          <span class="svc-arrow">→</span>
        </a>
        <a class="svc-card reveal" style="--d:0.1s;" href="/fr/services/">
          <span class="svc-code">LQA</span>
          <span class="svc-name">Assurance qualité</span>
          <span class="svc-desc">Relecture en contexte de votre version française : cohérence, troncatures, registre — avec un rapport priorisé et actionnable.</span>
          <span class="svc-arrow">→</span>
        </a>
        <a class="svc-card reveal" style="--d:0.15s;" href="/fr/services/">
          <span class="svc-code">LEAD</span>
          <span class="svc-name">Language Lead</span>
          <span class="svc-desc">Je pilote votre programme linguistique : guide de style, glossaire, stratégie de MT, relecture fournisseurs — une qualité qui suit vos releases.</span>
          <span class="svc-arrow">→</span>
        </a>
        <a class="svc-card reveal" style="--d:0.2s;" href="/fr/services/">
          <span class="svc-code">SEO</span>
          <span class="svc-name">Contenus SEO &amp; GEO</span>
          <span class="svc-desc">Des contenus adaptés aux intentions de recherche françaises — et aux moteurs de réponse IA que vos futurs clients interrogent déjà.</span>
          <span class="svc-arrow">→</span>
        </a>
        <a class="svc-card svc-card-cta reveal" style="--d:0.25s;" href="/fr/services/">
          <span class="svc-cta-label">Tous les services</span>
          <span class="svc-cta-sub">Vous ne savez pas ce qu'il vous faut ? Voyons ça ensemble.</span>
          <span class="svc-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ======== Derniers articles ======== -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow reveal">Sur le blog</span>
      <h2 class="display-l reveal" style="margin-bottom:2rem;">Derniers articles <span class="guillemet">(en anglais)</span></h2>

      {posts.map((post, i) => (
        <article class="post-card reveal" style={`--d:${i * 0.07}s;`}>
          <div class="post-meta">
            {fmt(post.data.pubDate)}
            <span class="tag">{post.data.tag}</span>
          </div>
          <div class="post-body">
            {post.data.image && (
              <a href={`/blog/${post.slug}/`} class="post-thumb" aria-hidden="true" tabindex="-1">
                <img src={post.data.image} alt="" loading="lazy" />
              </a>
            )}
            <div>
              <h3><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <a class="read-more" href={`/blog/${post.slug}/`}>Lire l'article <span class="rm-arrow">→</span></a>
            </div>
          </div>
        </article>
      ))}

      <p class="reveal" style="margin-top:2rem;">
        <a class="btn btn-ghost" href="/blog/">Tous les articles</a>
      </p>
    </div>
  </section>

  <!-- ======== Secteurs ======== -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow reveal">Secteurs</span>
      <div class="sectors reveal" style="--d:0.08s;">
        <span>SaaS</span>
        <span>Tech &amp; Cloud</span>
        <span>Jeu vidéo</span>
      </div>
    </div>
  </section>

  <!-- ======== Bandeau CTA ======== -->
  <section class="cta-band">
    <span class="deco" data-parallax="-0.08" aria-hidden="true">»</span>
    <div class="wrap">
      <h2 class="display-l reveal">Prêts à passer <span class="guillemet" style="color:#fff;">« en français »</span> ?</h2>
      <p class="reveal" style="--d:0.08s;">Parlez-moi de votre produit, de vos délais et de votre volume de chaînes. Vous recevrez un périmètre clair et un devis — sans agence intermédiaire.</p>
      <a class="btn reveal" style="--d:0.16s;" href="/fr/contact/">Me contacter</a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Services grid ---------- */
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }
  @media (max-width: 820px) { .svc-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .svc-grid { grid-template-columns: 1fr; } }

  .svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.5rem 1.5rem;
    border: 1px solid var(--line);
    background: #fff;
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    min-height: 200px;
    transition: transform 0.32s cubic-bezier(0.22,1,0.36,1),
                box-shadow 0.32s ease,
                border-color 0.32s ease;
  }
  /* sweeping gradient wash */
  .svc-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(155deg, var(--tint) 0%, #fff 55%);
    opacity: 0;
    transition: opacity 0.32s ease;
  }
  /* glow blob that follows into view */
  .svc-card::after {
    content: "";
    position: absolute;
    z-index: -1;
    width: 150px; height: 150px;
    right: -50px; top: -50px;
    background: radial-gradient(circle, rgba(83,74,183,0.16), transparent 70%);
    transform: scale(0);
    transition: transform 0.45s cubic-bezier(0.22,1,0.36,1);
  }
  .svc-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(83,74,183,0.18);
    border-color: var(--purple);
  }
  .svc-card:hover::before { opacity: 1; }
  .svc-card:hover::after { transform: scale(1.6); }

  .svc-code {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--purple);
    font-weight: 500;
    display: inline-block;
    transition: transform 0.32s cubic-bezier(0.22,1,0.36,1), letter-spacing 0.32s ease;
    transform-origin: left;
  }
  .svc-card:hover .svc-code { transform: scale(1.25); letter-spacing: 0.18em; }

  .svc-name {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.4rem;
    color: var(--ink);
    margin: 0.7rem 0 0.5rem;
    line-height: 1.15;
  }
  .svc-desc {
    font-size: 0.92rem;
    color: var(--grey);
    line-height: 1.55;
  }
  .svc-arrow {
    font-family: var(--body);
    font-size: 1.3rem;
    color: var(--purple);
    margin-top: auto;
    padding-top: 1rem;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .svc-card:hover .svc-arrow { opacity: 1; transform: translateX(0); }

  /* CTA card (last cell) */
  .svc-card-cta {
    background: linear-gradient(150deg, var(--purple), var(--purple-deep));
    border-color: transparent;
    justify-content: center;
  }
  .svc-card-cta::before { background: linear-gradient(150deg, var(--purple-deep), var(--purple)); }
  .svc-card-cta:hover { border-color: transparent; }
  .svc-cta-label {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.5rem;
    color: #fff;
  }
  .svc-cta-sub {
    font-size: 0.9rem;
    color: #D9D5F5;
    margin-top: 0.5rem;
    line-height: 1.5;
  }
  .svc-card-cta .svc-arrow { color: #fff; opacity: 1; transform: none; }
  .svc-card-cta:hover .svc-arrow { transform: translateX(5px); }

  /* ---------- Hero layout with photo ---------- */
  .hero-layout {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3.5rem;
    align-items: center;
  }
  .hero-photo { justify-self: center; }
  .hero-photo img {
    display: block;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 6px var(--tint), 0 18px 44px rgba(83, 74, 183, 0.28);
    animation: haloFloat 6s ease-in-out infinite;
  }
  @keyframes haloFloat {
    0%, 100% { box-shadow: 0 0 0 6px var(--tint), 0 18px 44px rgba(83, 74, 183, 0.28); transform: translateY(0); }
    50% { box-shadow: 0 0 0 10px var(--tint), 0 22px 50px rgba(83, 74, 183, 0.34); transform: translateY(-6px); }
  }
  @media (max-width: 820px) {
    .hero-layout { grid-template-columns: 1fr; gap: 2.2rem; }
    .hero-photo { order: -1; justify-self: start; }
    .hero-photo img { width: 150px; height: 150px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-photo img { animation: none; }
  }

  .lang-toggle a {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    padding: 0.5rem 1.1rem;
    color: var(--grey);
    display: inline-block;
  }
  .lang-toggle a:hover { color: var(--purple); }
  .lang-toggle a[aria-current="page"] { background: var(--purple); color: #fff; }

  .post-body { display: flex; gap: 1.6rem; align-items: flex-start; }
  .post-thumb { flex: 0 0 120px; order: 2; display: block; overflow: hidden; border: 1px solid var(--line); }
  .post-thumb img { display: block; width: 120px; height: 120px; object-fit: cover; transition: transform 0.4s ease; }
  .post-card:hover .post-thumb img { transform: scale(1.05); }
  @media (max-width: 640px) {
    .post-body { flex-direction: column; }
    .post-thumb { order: 0; }
    .post-thumb img { width: 100%; height: 160px; }
  }
</style>
