---
import Base from '../../layouts/Base.astro';
---
<Base lang="fr" title="Merci ! — FrenchSaaS" description="Votre message a bien été envoyé.">
  <section class="page-head">
    <div class="wrap">
      <div class="stagger"><span class="eyebrow">Message envoyé</span></div>
      <h1 class="display-xl stagger">Merci<span class="guillemet">.</span></h1>
      <p class="lede stagger">Votre message est en route — je vous réponds sous un jour ouvré.</p>
      <p class="stagger" style="margin-top:2rem;"><a class="btn btn-ghost" href="/fr/">Retour au site</a></p>
    </div>
  </section>
</Base>
