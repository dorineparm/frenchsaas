---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
---
<Base current="home">
  <!-- ======== Hero ======== -->
  <section class="hero">
    <span class="deco deco-guillemets" data-parallax="0.18" aria-hidden="true">«&nbsp;»</span>
    <span class="deco deco-locale" data-parallax="0.32" aria-hidden="true">fr-FR</span>

    <div class="wrap">
      <div class="hero-layout">
        <div class="hero-text">
      <div class="stagger"><span class="eyebrow">en-US <span class="arrow">→</span> fr-FR</span></div>

      <div class="stagger">
        <div class="lang-toggle" role="navigation" aria-label="This page in English or French">
          <a href="/" aria-current="page">EN</a>
          <a href="/fr/">FR</a>
        </div>
      </div>

      <h1 class="display-xl stagger">Helping your product feel at home in French.</h1>

      <p class="lede stagger">Localization, UX writing and linguistic QA for SaaS, tech and games — by a Language Lead who treats every string as a product decision.</p>

      <div class="hero-cta stagger">
        <a class="btn btn-solid" href="/contact/">Start a project</a>
        <a class="btn btn-ghost" href="/services/">See services</a>
      </div>
        </div><!-- /hero-text -->

        <div class="hero-photo stagger">
          <img src="/images/uploads/b62f33fc-9a70-4d11-84f1-30d981969f94.png" alt="Dorine Parmentier, Language Lead &amp; EN→FR localization specialist" loading="eager" />
        </div>
      </div><!-- /hero-layout -->
    </div>
  </section>

  <!-- ======== Manifesto ======== -->
  <section class="section manifesto">
    <div class="wrap">
      <span class="eyebrow reveal">Why it matters</span>
      <p class="reveal">France is one of the largest SaaS markets in Europe — and one of the least forgiving of machine-flavored copy. A French user can tell within one screen whether your product was <strong>localized</strong> or merely translated.</p>
      <p class="reveal" style="--d:0.12s;">Localization is not a string-replacement job. It is a series of expert linguistic decisions: tone, terminology, plurals, placeholders, CTAs, legal nuance. That is the work I do.</p>
    </div>
  </section>

  <!-- ======== Services grid ======== -->
  <section class="section services-section">
    <div class="wrap">
      <span class="eyebrow reveal">Services</span>
      <h2 class="display-l reveal" style="margin-bottom:2.4rem;">What I can do for your product</h2>

      <div class="svc-grid">
        <a class="svc-card reveal" href="/services/">
          <span class="svc-code">L10N</span>
          <span class="svc-name">Software localization</span>
          <span class="svc-desc">Your UI, onboarding, emails and help center — in French that feels native, strings handled right the first time.</span>
          <span class="svc-arrow">→</span>
        </a>
        <a class="svc-card reveal" style="--d:0.05s;" href="/services/">
          <span class="svc-code">UXW</span>
          <span class="svc-name">UX writing &amp; CTAs</span>
          <span class="svc-desc">Microcopy that converts in French: buttons, empty states and calls to action rewritten for how French users read and click.</span>
          <span class="svc-arrow">→</span>
        </a>
        <a class="svc-card reveal" style="--d:0.1s;" href="/services/">
          <span class="svc-code">LQA</span>
          <span class="svc-name">Linguistic QA</span>
          <span class="svc-desc">In-context review of your French build: consistency, truncations, register — with a prioritized report your team can act on.</span>
          <span class="svc-arrow">→</span>
        </a>
        <a class="svc-card reveal" style="--d:0.15s;" href="/services/">
          <span class="svc-code">LEAD</span>
          <span class="svc-name">Language Lead</span>
          <span class="svc-desc">I own your French language program: style guide, glossary, TM strategy, vendor review — quality that scales with releases.</span>
          <span class="svc-arrow">→</span>
        </a>
        <a class="svc-card reveal" style="--d:0.2s;" href="/services/">
          <span class="svc-code">SEO</span>
          <span class="svc-name">SEO &amp; GEO content</span>
          <span class="svc-desc">Content adapted for French search intent — and for the AI answer engines your future customers already ask.</span>
          <span class="svc-arrow">→</span>
        </a>
        <a class="svc-card svc-card-cta reveal" style="--d:0.25s;" href="/services/">
          <span class="svc-cta-label">All services</span>
          <span class="svc-cta-sub">Not sure what you need? Let's figure it out.</span>
          <span class="svc-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ======== Latest articles ======== -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow reveal">From the blog</span>
      <h2 class="display-l reveal" style="margin-bottom:2rem;">Latest articles</h2>

      {posts.map((post, i) => (
        <article class="post-card reveal" style={`--d:${i * 0.07}s;`}>
          <div class="post-meta">
            {fmt(post.data.pubDate)}
            <span class="tag">{post.data.tag}</span>
          </div>
          <div class="post-body">
            {post.data.image && (
              <a href={`/blog/${post.slug}/`} class="post-thumb" aria-hidden="true" tabindex="-1">
                <img src={post.data.image} alt="" loading="lazy" />
              </a>
            )}
            <div>
              <h3><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <a class="read-more" href={`/blog/${post.slug}/`}>Read the article <span class="rm-arrow">→</span></a>
            </div>
          </div>
        </article>
      ))}

      <p class="reveal" style="margin-top:2rem;">
        <a class="btn btn-ghost" href="/blog/">All articles</a>
      </p>
    </div>
  </section>

  <!-- ======== Free resource / lead magnet ======== -->
  <section class="section">
    <div class="wrap">
      <div class="resource-card reveal">
        <div class="resource-card-visual" aria-hidden="true">
          <div class="pdf-mock">
            <span class="pdf-mock-guill">«»</span>
            <span class="pdf-mock-tag">FREE PDF</span>
            <span class="pdf-mock-title">Is your product ready for French localization?</span>
            <span class="pdf-mock-lines"><i></i><i></i><i></i></span>
          </div>
        </div>
        <div class="resource-card-body">
          <span class="eyebrow">Free checklist</span>
          <h2 class="display-m">Is your product ready for French localization?</h2>
          <p>A 20-point readiness audit for SaaS, tech &amp; gaming teams — the checklist I run through before taking on a French localization project. Spot the gaps before you translate a single string.</p>
          <div class="resource-card-cta">
            <a class="btn btn-solid" href="/files/french-localization-readiness-checklist.pdf" target="_blank" rel="noopener">Download the checklist →</a>
            <span class="resource-card-note">PDF · 5 pages · no sign-up</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== Sectors ======== -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow reveal">Sectors</span>
      <div class="sectors reveal" style="--d:0.08s;">
        <span>SaaS</span>
        <span>Tech &amp; Cloud</span>
        <span>AI / ML</span>
        <span>Gaming</span>
      </div>
    </div>
  </section>

  <!-- ======== CTA band ======== -->
  <section class="cta-band">
    <span class="deco" data-parallax="-0.08" aria-hidden="true">»</span>
    <div class="wrap">
      <h2 class="display-l reveal">Ready to go <span class="guillemet" style="color:#fff;">« en français »</span> ?</h2>
      <p class="reveal" style="--d:0.08s;">Tell me about your product, your timeline and your string count. You'll get a clear scope and a quote — no agency layers, no middlemen.</p>
      <a class="btn reveal" style="--d:0.16s;" href="/contact/">Get in touch</a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Services grid ---------- */
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }
  @media (max-width: 820px) { .svc-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .svc-grid { grid-template-columns: 1fr; } }

  .svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.5rem 1.5rem;
    border: 1px solid var(--line);
    background: #fff;
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    min-height: 200px;
    transition: transform 0.32s cubic-bezier(0.22,1,0.36,1),
                box-shadow 0.32s ease,
                border-color 0.32s ease;
  }
  /* sweeping gradient wash */
  .svc-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(155deg, var(--tint) 0%, #fff 55%);
    opacity: 0;
    transition: opacity 0.32s ease;
  }
  /* glow blob that follows into view */
  .svc-card::after {
    content: "";
    position: absolute;
    z-index: -1;
    width: 150px; height: 150px;
    right: -50px; top: -50px;
    background: radial-gradient(circle, rgba(83,74,183,0.16), transparent 70%);
    transform: scale(0);
    transition: transform 0.45s cubic-bezier(0.22,1,0.36,1);
  }
  .svc-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(83,74,183,0.18);
    border-color: var(--purple);
  }
  .svc-card:hover::before { opacity: 1; }
  .svc-card:hover::after { transform: scale(1.6); }

  .svc-code {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--purple);
    font-weight: 500;
    display: inline-block;
    transition: transform 0.32s cubic-bezier(0.22,1,0.36,1), letter-spacing 0.32s ease;
    transform-origin: left;
  }
  .svc-card:hover .svc-code { transform: scale(1.25); letter-spacing: 0.18em; }

  .svc-name {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.4rem;
    color: var(--ink);
    margin: 0.7rem 0 0.5rem;
    line-height: 1.15;
  }
  .svc-desc {
    font-size: 0.92rem;
    color: var(--grey);
    line-height: 1.55;
  }
  .svc-arrow {
    font-family: var(--body);
    font-size: 1.3rem;
    color: var(--purple);
    margin-top: auto;
    padding-top: 1rem;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .svc-card:hover .svc-arrow { opacity: 1; transform: translateX(0); }

  /* CTA card (last cell) */
  .svc-card-cta {
    background: linear-gradient(150deg, var(--purple), var(--purple-deep));
    border-color: transparent;
    justify-content: center;
  }
  .svc-card-cta::before { background: linear-gradient(150deg, var(--purple-deep), var(--purple)); }
  .svc-card-cta:hover { border-color: transparent; }
  .svc-cta-label {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.5rem;
    color: #fff;
  }
  .svc-cta-sub {
    font-size: 0.9rem;
    color: #D9D5F5;
    margin-top: 0.5rem;
    line-height: 1.5;
  }
  .svc-card-cta .svc-arrow { color: #fff; opacity: 1; transform: none; }
  .svc-card-cta:hover .svc-arrow { transform: translateX(5px); }

  /* ---------- Hero layout with photo ---------- */
  .hero-layout {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3.5rem;
    align-items: center;
  }
  .hero-photo { justify-self: center; }
  .hero-photo img {
    display: block;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 6px var(--tint), 0 18px 44px rgba(83, 74, 183, 0.28);
    animation: haloFloat 6s ease-in-out infinite;
  }
  @keyframes haloFloat {
    0%, 100% { box-shadow: 0 0 0 6px var(--tint), 0 18px 44px rgba(83, 74, 183, 0.28); transform: translateY(0); }
    50% { box-shadow: 0 0 0 10px var(--tint), 0 22px 50px rgba(83, 74, 183, 0.34); transform: translateY(-6px); }
  }
  @media (max-width: 820px) {
    .hero-layout { grid-template-columns: 1fr; gap: 2.2rem; }
    .hero-photo { order: -1; justify-self: start; }
    .hero-photo img { width: 150px; height: 150px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-photo img { animation: none; }
  }

  /* The old EN/FR toggle becomes real links to / and /fr/ */
  .lang-toggle a {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    padding: 0.5rem 1.1rem;
    color: var(--grey);
    display: inline-block;
  }
  .lang-toggle a:hover { color: var(--purple); }
  .lang-toggle a[aria-current="page"] { background: var(--purple); color: #fff; }

  .post-body { display: flex; gap: 1.6rem; align-items: flex-start; }
  .post-thumb { flex: 0 0 120px; order: 2; display: block; overflow: hidden; border: 1px solid var(--line); }
  .post-thumb img { display: block; width: 120px; height: 120px; object-fit: cover; transition: transform 0.4s ease; }
  .post-card:hover .post-thumb img { transform: scale(1.05); }
  @media (max-width: 640px) {
    .post-body { flex-direction: column; }
    .post-thumb { order: 0; }
    .post-thumb img { width: 100%; height: 160px; }
  }

  /* ---------- Free resource / lead magnet card ---------- */
  .resource-card {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 0;
    border: 1px solid var(--line);
    overflow: hidden;
    background: #fff;
  }
  .resource-card-visual {
    background: linear-gradient(150deg, var(--purple) 0%, var(--purple-deep) 100%);
    padding: 3rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .pdf-mock {
    background: #fff;
    width: 100%;
    max-width: 200px;
    aspect-ratio: 3 / 4;
    box-shadow: 0 18px 40px rgba(23, 20, 43, 0.28);
    padding: 1.4rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    position: relative;
    transform: rotate(-3deg);
    transition: transform 0.4s ease;
  }
  .resource-card:hover .pdf-mock { transform: rotate(0deg) translateY(-4px); }
  .pdf-mock-guill {
    position: absolute;
    top: -0.3em;
    right: 0.1em;
    font-family: var(--display);
    font-style: italic;
    font-weight: 700;
    font-size: 4rem;
    line-height: 1;
    color: var(--tint);
  }
  .pdf-mock-tag {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: var(--purple);
    font-weight: 600;
  }
  .pdf-mock-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.2;
    color: var(--ink);
    position: relative;
    z-index: 1;
  }
  .pdf-mock-lines { margin-top: auto; display: flex; flex-direction: column; gap: 0.4rem; }
  .pdf-mock-lines i { height: 3px; background: var(--line); border-radius: 2px; display: block; }
  .pdf-mock-lines i:nth-child(1) { width: 100%; }
  .pdf-mock-lines i:nth-child(2) { width: 85%; }
  .pdf-mock-lines i:nth-child(3) { width: 60%; }

  .resource-card-body { padding: 2.6rem 2.4rem; }
  .resource-card-body h2 { margin: 0.3rem 0 0.9rem; }
  .resource-card-body p { color: var(--grey); font-size: 0.97rem; max-width: 34em; }
  .resource-card-cta {
    margin-top: 1.6rem;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-wrap: wrap;
  }
  .resource-card-note {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--grey);
    text-transform: uppercase;
  }
  @media (max-width: 720px) {
    .resource-card { grid-template-columns: 1fr; }
    .resource-card-visual { padding: 2.4rem; }
  }
</style>
