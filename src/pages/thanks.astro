---
import Base from '../layouts/Base.astro';
---
<Base title="Merci ! — FrenchSaaS" description="Your message has been sent.">
  <section class="page-head">
    <div class="wrap">
      <div class="stagger"><span class="eyebrow">Message sent</span></div>
      <h1 class="display-xl stagger">Merci<span class="guillemet">.</span></h1>
      <p class="lede stagger">Your message is on its way — I'll get back to you within one business day.</p>
      <p class="stagger" style="margin-top:2rem;"><a class="btn btn-ghost" href="/">Back to the site</a></p>
    </div>
  </section>
</Base>
